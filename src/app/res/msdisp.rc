// msdisp.exe resources: icon, manifest (PerMonitorV2, comctl32 v6, asInvoker), version info.
#include <windows.h>
#include "../resource.h"

IDI_APP ICON "msdisp.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "msdisp.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "msdisp - monitor USB em modo retrato"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "msdisp"
      VALUE "OriginalFilename", "msdisp.exe"
      VALUE "ProductName", "msdisp-portrait"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
